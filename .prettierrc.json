{
  "useTabs": true,
  "tabWidth": 4,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "semi": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "overrides": [
    {
      "files": ["*.css", "*.json", "*.yml", "*.yaml", "*.md"],
      "options": {
        "useTabs": false,
        "tabWidth": 2,
        "singleQuote": false
      }
    }
  ]
}
