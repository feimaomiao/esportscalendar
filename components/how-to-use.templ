package components

templ HowToUsePage() {
	@BaseLayout("How to Use - EsportsCalendar") {
		<div class="container mx-auto p-4">
			<div class="max-w-4xl mx-auto">
				<div class="card bg-base-100 border border-base-300">
					<div class="card-body">
						<div class="flex items-baseline justify-between mb-1">
							<span class="hud-label">{ "// manual" }</span>
							<span class="hud-label hud-bracket">how to use</span>
						</div>
						<h1 class="hud-display text-3xl mb-4">Operations</h1>
						<p class="hud-mono text-sm opacity-60 mb-6">
							Build a calendar feed on the homepage, then subscribe to it in your calendar app.
						</p>
						<div class="space-y-6">
							<!-- Step 1 -->
							<div class="hud-game-module">
								<div class="hud-game-module-head">
									<span class="hud-step-num">{ "[ 01 ]" }</span>
									<h2 class="hud-display text-lg">Switch on the games you follow</h2>
								</div>
								<div class="hud-game-module-body">
									<p>
										Each game has a chip above the calendar grid. Click to turn it on. The grid then fills with upcoming matches for everything you switched on.
									</p>
									<div class="hud-alert hud-alert-info mt-3">
										@IconInfo("stroke-current shrink-0 w-5 h-5")
										<span>One feed covers every game you turn on, so you can stack several into the same calendar.</span>
									</div>
								</div>
							</div>
							<!-- Step 2 -->
							<div class="hud-game-module">
								<div class="hud-game-module-head">
									<span class="hud-step-num">{ "[ 02 ]" }</span>
									<h2 class="hud-display text-lg">Tune leagues, teams, and tier</h2>
								</div>
								<div class="hud-game-module-body">
									<p>
										Hit Tune to open the side drawer. For each game you have on, narrow it down — pick specific leagues, follow specific teams, or set a minimum tournament tier. Skip Tune entirely if you want everything for a game.
									</p>
									<ul class="mt-3 space-y-2">
										<li class="flex items-start gap-3">
											<span class="hud-mono text-primary text-xs mt-1">›</span>
											<div><strong class="hud-mono uppercase tracking-wider text-sm">Leagues</strong> — type to search; only matches in those leagues show up</div>
										</li>
										<li class="flex items-start gap-3">
											<span class="hud-mono text-primary text-xs mt-1">›</span>
											<div><strong class="hud-mono uppercase tracking-wider text-sm">Teams</strong> — pin specific teams across every tournament</div>
										</li>
										<li class="flex items-start gap-3">
											<span class="hud-mono text-primary text-xs mt-1">›</span>
											<div><strong class="hud-mono uppercase tracking-wider text-sm">Tier</strong> — Tier S is the top; "All" keeps qualifiers and lower brackets in</div>
										</li>
									</ul>
								</div>
							</div>
							<!-- Step 3 -->
							<div class="hud-game-module">
								<div class="hud-game-module-head">
									<span class="hud-step-num">{ "[ 03 ]" }</span>
									<h2 class="hud-display text-lg">Check the grid, then Export</h2>
								</div>
								<div class="hud-game-module-body">
									<p>
										The grid reflects your filters in real time. Click any day to see the full matchups. When it looks right, hit Export — you'll get a feed URL.
									</p>
									<div class="hud-alert hud-alert-success mt-3">
										@IconCheckCircle("stroke-current shrink-0 w-5 h-5")
										<span>Filters are saved into the URL itself, so the feed keeps pulling in new matches that fit your settings without you coming back.</span>
									</div>
								</div>
							</div>
							<!-- Step 4 -->
							<div class="hud-game-module">
								<div class="hud-game-module-head">
									<span class="hud-step-num">{ "[ 04 ]" }</span>
									<h2 class="hud-display text-lg">Subscribe to the feed</h2>
								</div>
								<div class="hud-game-module-body">
									<p class="mb-4">
										Paste the URL into any calendar app that supports subscribing to a .ics link. Don't import — subscribe, so it stays in sync.
									</p>
									<label class="hud-collapse">
										<input type="checkbox"/>
										<span class="hud-collapse-title">Apple Calendar (macOS / iOS)</span>
										<div class="hud-collapse-content">
											<ol class="list-decimal list-inside space-y-2 mt-2 text-sm">
												<li>Copy the feed URL</li>
												<li>Open Calendar</li>
												<li>macOS: <strong>File → New Calendar Subscription</strong>. iOS: <strong>Settings → Calendar → Accounts → Add Account → Other → Add Subscribed Calendar</strong></li>
												<li>Paste the URL and confirm</li>
												<li>Pick a name and color if you want</li>
											</ol>
										</div>
									</label>
									<label class="hud-collapse">
										<input type="checkbox"/>
										<span class="hud-collapse-title">Google Calendar</span>
										<div class="hud-collapse-content">
											<ol class="list-decimal list-inside space-y-2 mt-2 text-sm">
												<li>Copy the feed URL</li>
												<li>Open Google Calendar on web (the mobile app can't add subscriptions, but it'll show them once added on web)</li>
												<li>Click <strong>+</strong> next to "Other calendars" → <strong>From URL</strong></li>
												<li>Paste the URL and click <strong>Add calendar</strong></li>
											</ol>
										</div>
									</label>
									<label class="hud-collapse">
										<input type="checkbox"/>
										<span class="hud-collapse-title">Outlook</span>
										<div class="hud-collapse-content">
											<ol class="list-decimal list-inside space-y-2 mt-2 text-sm">
												<li>Copy the feed URL</li>
												<li>Open Outlook Calendar</li>
												<li><strong>Add Calendar → Subscribe from web</strong></li>
												<li>Paste the URL, name it, then <strong>Import</strong></li>
											</ol>
										</div>
									</label>
								</div>
							</div>
							<!-- Notes -->
							<div class="hud-game-module">
								<div class="hud-game-module-head">
									@IconInfo("h-5 w-5 stroke-current text-primary")
									<h2 class="hud-display text-lg">Notes</h2>
								</div>
								<div class="hud-game-module-body">
									<div class="space-y-2 text-sm">
										<p><strong class="hud-mono uppercase tracking-wider text-xs">Time zone:</strong> Match times are stored in UTC; your calendar app converts to local time on its own.</p>
										<p><strong class="hud-mono uppercase tracking-wider text-xs">Sync delay:</strong> Subscribed feeds aren't push — calendar apps poll on their own schedule, anywhere from an hour to a day.</p>
										<p><strong class="hud-mono uppercase tracking-wider text-xs">Changing filters:</strong> Re-export to get a new URL. The old subscription will keep running with the old filters until you swap it out.</p>
									</div>
								</div>
							</div>
							<div class="card-actions justify-center mt-2">
								<a href="/" class="btn btn-primary btn-lg">
									&gt; Open the calendar
									@IconArrowRight("w-5 h-5")
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
