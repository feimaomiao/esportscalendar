package components

import "github.com/feimaomiao/esportscalendar/dbtypes"
import "fmt"
import "time"

templ HUDMatchRow(match dbtypes.GetFutureMatchesBySelectionsRow, hideScores bool) {
	<div class="hud-match" data-status={ matchStatus(match) }>
		<span class="hud-match-game" title={ match.GameName }>{ match.GameName }</span>
		<div class="flex items-center gap-3 flex-1 min-w-[14rem]">
			<div class="flex items-center gap-2 flex-1 min-w-0 justify-end">
				<span class="hud-team-name truncate">
					if match.Team1Acronym.Valid && match.Team1Acronym.String != "" {
						{ match.Team1Acronym.String }
					} else if match.Team1Name.Valid {
						{ match.Team1Name.String }
					} else {
						TBD
					}
				</span>
				<span class="hud-logo hud-logo-sm">
					if match.Team1Image.Valid && match.Team1Image.String != "" {
						if match.Team1Name.Valid {
							<img src={ match.Team1Image.String } alt={ match.Team1Name.String }/>
						} else {
							<img src={ match.Team1Image.String } alt="TBD"/>
						}
					} else {
						<img src="/static/images/default-logo.png" alt="TBD"/>
					}
				</span>
			</div>
			<span class="hud-vs">VS</span>
			<div class="flex items-center gap-2 flex-1 min-w-0">
				<span class="hud-logo hud-logo-sm">
					if match.Team2Image.Valid && match.Team2Image.String != "" {
						if match.Team2Name.Valid {
							<img src={ match.Team2Image.String } alt={ match.Team2Name.String }/>
						} else {
							<img src={ match.Team2Image.String } alt="TBD"/>
						}
					} else {
						<img src="/static/images/default-logo.png" alt="TBD"/>
					}
				</span>
				<span class="hud-team-name truncate">
					if match.Team2Acronym.Valid && match.Team2Acronym.String != "" {
						{ match.Team2Acronym.String }
					} else if match.Team2Name.Valid {
						{ match.Team2Name.String }
					} else {
						TBD
					}
				</span>
			</div>
		</div>
		<div class="hud-time flex items-center gap-2 flex-shrink-0">
			if match.ExpectedStartTime.Valid {
				<span class="match-time whitespace-nowrap" data-utc-time={ match.ExpectedStartTime.Time.Format("2006-01-02T15:04:05Z07:00") }>
					<span class="hud-time-date match-date">{ match.ExpectedStartTime.Time.Format("Jan 02") }</span>
					<span class="hud-time-hour match-hour ml-1">{ match.ExpectedStartTime.Time.Format("15:04") }</span>
				</span>
			} else {
				<span class="opacity-50">— : —</span>
			}
		</div>
		<div class="flex-shrink-0">
			if match.Finished {
				if hideScores {
					<span class="hud-status hud-status-finished">Final</span>
				} else {
					<span class="hud-status hud-status-finished">{ fmt.Sprintf("%d–%d", match.Team1Score, match.Team2Score) }</span>
				}
			} else if match.ExpectedStartTime.Valid && match.ExpectedStartTime.Time.Before(time.Now()) {
				<span class="hud-status hud-status-ongoing">Ongoing</span>
			} else {
				<span class="hud-status hud-status-upcoming">Upcoming</span>
			}
		</div>
		<div class="hud-meta">
			<span class="truncate" title={ match.Name }>{ match.Name }</span>
			<span class="hidden md:inline opacity-50">·</span>
			<span class="hidden md:inline truncate" title={ match.LeagueName }>{ match.LeagueName }</span>
		</div>
	</div>
}

func matchStatus(match dbtypes.GetFutureMatchesBySelectionsRow) string {
	if match.Finished {
		return "finished"
	}
	if match.ExpectedStartTime.Valid && match.ExpectedStartTime.Time.Before(time.Now()) {
		return "ongoing"
	}
	return "upcoming"
}
