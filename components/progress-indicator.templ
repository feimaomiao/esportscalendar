package components

// ProgressIndicator shows the current step in the calendar creation flow
// currentStep: 1 = Select Games, 2 = Select Leagues/Teams, 3 = Preview/Export
templ ProgressIndicator(currentStep int) {
	<div class="w-full bg-base-200 mb-6">
		<div class="container mx-auto px-2 md:px-4">
			<div class="hud-steps">
				<div class={ "hud-step", templ.KV("is-active", currentStep == 1), templ.KV("is-done", currentStep > 1) }>
					<span class="hud-step-num">{ "[ 01 ]" }</span>
					<div class="flex flex-col leading-tight">
						<span class="hud-step-label">Select</span>
						<span class="hud-step-sub">Choose esports</span>
					</div>
				</div>
				<div class={ "hud-step", templ.KV("is-active", currentStep == 2), templ.KV("is-done", currentStep > 2) }>
					<span class="hud-step-num">{ "[ 02 ]" }</span>
					<div class="flex flex-col leading-tight">
						<span class="hud-step-label">Tune</span>
						<span class="hud-step-sub">Filter selections</span>
					</div>
				</div>
				<div class={ "hud-step", templ.KV("is-active", currentStep == 3), templ.KV("is-done", currentStep > 3) }>
					<span class="hud-step-num">{ "[ 03 ]" }</span>
					<div class="flex flex-col leading-tight">
						<span class="hud-step-label">Export</span>
						<span class="hud-step-sub">Get calendar feed</span>
					</div>
				</div>
			</div>
		</div>
	</div>
}
