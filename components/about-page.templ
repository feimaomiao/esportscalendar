package components

templ AboutPage() {
	@BaseLayout("About - EsportsCalendar") {
		<div class="container mx-auto p-4">
			<div class="max-w-4xl mx-auto">
				<div class="card bg-base-100 border border-base-300">
					<div class="card-body">
						<div class="flex items-baseline justify-between mb-1">
							<span class="hud-label">{ "// system.info" }</span>
							<span class="hud-label hud-bracket">about</span>
						</div>
						<h1 class="hud-display text-3xl mb-6">EsportsCalendar</h1>
						<section class="mb-8 space-y-4 text-base-content/80 leading-relaxed">
							<p>
								Esports schedules are scattered — one site per game, each with its own format and timezone. EsportsCalendar collapses everything you follow into a single calendar feed.
							</p>
							<p>
								Subscribe to it once in Google Calendar, Apple Calendar, or Outlook, and matches show up alongside the rest of your week. The feed keeps itself current as new tournaments are announced, so there's nothing to come back for.
							</p>
						</section>
						<section class="mb-8">
							<h2 class="hud-section-heading text-lg mb-3">What's covered</h2>
							<ul class="space-y-2 text-base-content/80">
								<li class="flex gap-3">
									<span class="hud-mono text-primary text-xs mt-1">›</span>
									<span>League of Legends, Counter-Strike, Dota 2, Valorant, Rocket League, Rainbow Six Siege, Mobile Legends, and a few more</span>
								</li>
								<li class="flex gap-3">
									<span class="hud-mono text-primary text-xs mt-1">›</span>
									<span>Filter by league, by team, or by minimum tournament tier so qualifiers and lower brackets stay out</span>
								</li>
								<li class="flex gap-3">
									<span class="hud-mono text-primary text-xs mt-1">›</span>
									<span>UTC under the hood; your calendar app handles local time</span>
								</li>
								<li class="flex gap-3">
									<span class="hud-mono text-primary text-xs mt-1">›</span>
									<span>Plain .ics — works in any app that subscribes to a calendar URL</span>
								</li>
								<li class="flex gap-3">
									<span class="hud-mono text-primary text-xs mt-1">›</span>
									<span>No account, no login, no payment</span>
								</li>
							</ul>
						</section>
						<section class="mb-8">
							<h2 class="hud-section-heading text-lg mb-3">Where the data comes from</h2>
							<p class="text-base-content/80 leading-relaxed mb-3">
								Match data comes from the PandaScore API. New matches and schedule changes flow through automatically.
							</p>
							<div class="hud-alert hud-alert-info">
								@IconInfo("stroke-current shrink-0 w-5 h-5")
								<span>Calendar apps poll subscribed feeds on their own clock, usually somewhere between an hour and a day, so a new match can take a while to appear.</span>
							</div>
						</section>
						<section class="mb-8">
							<h2 class="hud-section-heading text-lg mb-3">Building a feed</h2>
							<p class="text-base-content/80 leading-relaxed">
								Switch on the games you follow, optionally tune leagues, teams, and tier in the side drawer, then hit Export to get a URL. The walkthrough is on <a href="/how-to-use" class="link link-primary">How to use</a>.
							</p>
						</section>
						<section class="mb-8">
							<h2 class="hud-section-heading text-lg mb-3">Open source</h2>
							<p class="text-base-content/80 leading-relaxed mb-4">
								The whole thing is on GitHub — Go on the backend, templ for HTML, HTMX for partial swaps, Tailwind and DaisyUI for styling. Bug reports, feature ideas, and missing leagues are all fair game.
							</p>
							<div class="flex flex-col sm:flex-row gap-3">
								<a href="https://github.com/feimaomiao/esportscalendar" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
									@IconGitHub("w-5 h-5")
									&gt; View on GitHub
								</a>
								<a href="https://github.com/feimaomiao/esportscalendar/issues" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
									Report an issue
								</a>
							</div>
						</section>
						<section class="mb-4">
							<h2 class="hud-section-heading text-lg mb-3">Support</h2>
							<p class="text-base-content/80 leading-relaxed mb-4">
								Hosting and the PandaScore subscription cost money. If the tool earns its keep for you, the coffee link helps cover that. No obligation.
							</p>
							<a href="https://www.buymeacoffee.com/feimaomiao" target="_blank" rel="noopener noreferrer" class="btn btn-accent">
								Buy me a coffee
							</a>
						</section>
						<div class="card-actions justify-start mt-8">
							<a href="/" class="btn btn-ghost">
								@IconArrowLeft("w-5 h-5")
								Back to calendar
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
