package components

templ Index(options []Option) {
	@BaseLayout("Select Games - EsportsCalendar") {
		@IndexInner(options)
	}
}

templ IndexInner(options []Option) {
	@ProgressIndicator(1)
	<div id="select" class="container mx-auto p-4">
		<div class="max-w-2xl mx-auto">
			<div class="card bg-base-100 border border-base-300">
				<div class="card-body">
					<div class="flex items-baseline justify-between mb-1">
						<span class="hud-label">{ "// channel.01" }</span>
						<span class="hud-label hud-bracket">target select</span>
					</div>
					<h1 class="hud-display text-2xl md:text-3xl mb-2 hud-caret">Select games to track</h1>
					<p class="hud-mono text-sm opacity-60 mb-6">
						Choose one or more titles. Calendar feed will only include matches from selected games.
					</p>
					<form
						id="game-form"
						action="/lts"
						method="POST"
						hx-post="/lts"
						hx-target="#page-content"
						hx-swap="innerHTML"
						hx-push-url="/lts"
					>
						<div class="space-y-2" id="game-options">
							for _, opt := range options {
								<label class="hud-target-row">
									<div class="flex items-center gap-4 flex-1 min-w-0">
										<span class="hud-logo hud-logo-md">
											<img src={ opt.Logo } alt={ opt.Label }/>
										</span>
										<span class="hud-target-label truncate">{ opt.Label }</span>
									</div>
									<input
										type="checkbox"
										name="options"
										value={ opt.ID }
										class="checkbox checkbox-primary game-checkbox flex-shrink-0"
										if opt.Checked {
											checked
										}
									/>
								</label>
							}
						</div>
						<div class="flex items-center justify-between mt-6 gap-4">
							<span class="hud-counter hud-bracket"><span id="game-counter">0</span> selected</span>
							<button type="submit" id="continue-btn" class="btn btn-primary" disabled>
								&gt; Continue
								@IconArrowRight("w-5 h-5")
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
	<script src="/static/js/index.js"></script>
}
