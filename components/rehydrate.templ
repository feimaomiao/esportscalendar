package components

// RehydratePage is rendered on a fresh GET to a page whose state lives only in
// the user's sessionStorage (e.g. /lts and /preview). It shows a brief
// "restoring session" panel and loads /static/js/rehydrate.js, which reads
// the saved payload, POSTs it back to the same URL, and swaps the result into
// #page-content. If sessionStorage is empty the script redirects to "/".
//
//   sessionKey   sessionStorage key holding the saved payload
//   targetURL    URL to POST the rehydration request to
//   bodyMode     "json" — payload is already a JSON string, POST as-is
//                "form-options" — payload is a JSON array of IDs, POST as
//                form-encoded "options=A&options=B&..."
//   finalTitle   document.title to set after a successful swap
templ RehydratePage(sessionKey, targetURL, bodyMode, finalTitle string) {
	@BaseLayout("Restoring - EsportsCalendar") {
		@RehydrateShell(sessionKey, targetURL, bodyMode, finalTitle)
	}
}

templ RehydrateShell(sessionKey, targetURL, bodyMode, finalTitle string) {
	<div class="container mx-auto p-4 mt-8">
		<div class="max-w-md mx-auto">
			<div class="card bg-base-100 border border-base-300">
				<div class="card-body items-center text-center py-10">
					<div class="flex items-baseline justify-between w-full mb-2">
						<span class="hud-label">{ "// session" }</span>
						<span class="hud-label hud-bracket">restoring</span>
					</div>
					<span class="loading loading-spinner loading-lg" role="status" aria-label="Restoring session"></span>
					<p class="hud-mono uppercase tracking-widest text-xs mt-4 opacity-70">
						{ "[ rehydrating ]" }
					</p>
					<p class="hud-mono text-xs opacity-50 mt-1">
						If this takes more than a moment, you'll be returned home.
					</p>
				</div>
			</div>
		</div>
	</div>
	<div
		id="hud-rehydrate-config"
		data-session-key={ sessionKey }
		data-target-url={ targetURL }
		data-body-mode={ bodyMode }
		data-final-title={ finalTitle }
		hidden="hidden"
	></div>
	<script src="/static/js/rehydrate.js"></script>
}
