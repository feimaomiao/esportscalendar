package components

templ SecondPage(selectedOptions []Option) {
	@BaseLayout("Leagues & Teams - EsportsCalendar") {
		@SecondPageInner(selectedOptions)
	}
}

templ SecondPageInner(selectedOptions []Option) {
	@ProgressIndicator(2)
	<div class="container mx-auto p-4">
		<div class="max-w-5xl mx-auto">
			@SecondPageContent(selectedOptions)
		</div>
	</div>
	<script src="/static/js/lts.js"></script>
}

templ SecondPageContent(selectedOptions []Option) {
	<div class="card bg-base-100 border border-base-300">
		<div class="card-body">
			<div class="flex items-baseline justify-between mb-1">
				<span class="hud-label">{ "// channel.02" }</span>
				<span class="hud-label hud-bracket">filter &amp; tune</span>
			</div>
			<h2 class="hud-display text-2xl mb-2">Leagues &amp; Teams</h2>
			<p class="hud-mono text-xs opacity-60 mb-4">
				Filter each title down to the leagues, teams, and tournament tiers you want.
			</p>
			if len(selectedOptions) > 0 {
				<div class="flex flex-col gap-3" id="game-cards-container">
					for _, option := range selectedOptions {
						@GameSelectionCard(option)
					}
				</div>
			} else {
				<div class="hud-alert hud-alert-warning" role="alert">
					<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
					</svg>
					<span>No options were selected. Go back and select at least one game.</span>
				</div>
			}
			<div class="card-actions flex-col md:flex-row md:justify-between gap-4 mt-6">
				<button type="button" id="back-to-options-btn" class="btn btn-outline w-full md:w-auto">
					@IconArrowLeft("w-5 h-5")
					Back
				</button>
				<div class="flex flex-col items-stretch md:items-end gap-2 w-full md:w-auto">
					<label class="hud-mono text-xs uppercase tracking-widest flex items-center gap-2 cursor-pointer justify-center md:justify-end">
						<input type="checkbox" id="hide-scores-checkbox" class="checkbox checkbox-primary checkbox-sm"/>
						<span>Spoiler Block</span>
					</label>
					<button type="button" id="submit-selection-btn" class="btn btn-primary w-full md:w-auto" disabled>
						&gt; Submit
						@IconArrowRight("w-5 h-5")
					</button>
				</div>
			</div>
			<div id="result" class="mt-4"></div>
		</div>
	</div>
}

templ GameSelectionCard(option Option) {
	<div class="hud-game-module" data-game-id={ option.ID }>
		<div class="hud-game-module-head">
			<span class="hud-logo hud-logo-lg">
				<img src={ option.Logo } alt={ option.Label }/>
			</span>
			<div class="flex flex-col leading-tight">
				<span class="hud-label">{ "// module" }</span>
				<h4 class="hud-display text-lg">{ option.Label }</h4>
			</div>
		</div>
		<div class="hud-game-module-body">
			<div class="flex justify-between items-center mb-2">
				<span class="hud-label">{ "// selected" }</span>
				<button type="button" id={ "deselect-all-" + option.ID } class="hud-mono text-xs uppercase tracking-widest text-base-content/60 hover:text-secondary transition-colors flex items-center gap-1">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
					Clear
				</button>
			</div>
			<div id={ "selected-combined-" + option.ID } class="selected-items-container"></div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start mt-4">
				<div>
					<span class="hud-label block mb-2">{ "// search leagues" }</span>
					<div class="relative w-full" id={ "dropdown-container-" + option.ID }>
						<div class="hud-input-wrap">
							<input
								type="text"
								id={ "search-" + option.ID }
								placeholder="type to search..."
								class="hud-input"
								autocomplete="off"
							/>
						</div>
						<div class="dropdown-menu" id={ "dropdown-menu-" + option.ID }>
							<div id={ "loading-" + option.ID } class="dropdown-loading">
								<span class="loading loading-spinner loading-sm"></span>
								<span class="ml-2 hud-mono text-xs">Loading leagues...</span>
							</div>
							<ul class="menu p-2 w-full hidden" id={ "league-list-" + option.ID }></ul>
							<div class="dropdown-no-results hud-mono text-xs" id={ "no-results-" + option.ID }>
								No leagues found
							</div>
						</div>
					</div>
				</div>
				<div>
					<span class="hud-label block mb-2">{ "// search teams" }</span>
					<div class="relative w-full" id={ "dropdown-teams-container-" + option.ID }>
						<div class="hud-input-wrap">
							<input
								type="text"
								id={ "search-teams-" + option.ID }
								placeholder="type to search..."
								class="hud-input"
								autocomplete="off"
							/>
						</div>
						<div class="dropdown-menu" id={ "dropdown-teams-menu-" + option.ID }>
							<div id={ "loading-teams-" + option.ID } class="dropdown-loading">
								<span class="loading loading-spinner loading-sm"></span>
								<span class="ml-2 hud-mono text-xs">Loading teams...</span>
							</div>
							<ul class="menu p-2 w-full hidden" id={ "team-list-" + option.ID }></ul>
							<div class="dropdown-no-results hud-mono text-xs" id={ "no-teams-results-" + option.ID }>
								No teams found
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="mt-5">
				<div class="mb-2 flex items-center justify-between gap-2">
					<div class="flex items-center gap-2">
						<span class="hud-label">{ "// min tier" }</span>
						<div class="tooltip" data-tip="Different tiered tournaments may exist within the same league. Putting this slider to S will only show matches with an S tier tournament within the selected leagues.">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-info cursor-help" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
						</div>
					</div>
					<span class="hud-mono text-sm font-bold tracking-widest text-primary" id={ "tier-value-" + option.ID }>A</span>
				</div>
				<input
					type="range"
					min="1"
					max="6"
					value="2"
					class="hud-slider"
					id={ "tier-slider-" + option.ID }
					aria-label="Minimum tournament tier"
				/>
				<div class="hud-slider-ticks">
					<span>S</span>
					<span>A</span>
					<span>B</span>
					<span>C</span>
					<span>D</span>
					<span>All</span>
				</div>
			</div>
		</div>
	</div>
}
